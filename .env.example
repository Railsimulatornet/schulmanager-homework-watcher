# Schulmanager Watcher - Beispielkonfiguration (.env.example)
# Kopiere diese Datei nach ".env" und trage deine Zugangsdaten ein.
# Hinweis: Diese Datei enthält KEINE echten Zugangsdaten und ist für die Veröffentlichung gedacht.

# Zeitzone (für Datums-/Zeitformat in Mails & Logs)
TZ=Europe/Berlin

# Schulmanager Login (Eltern-/Schülerkonto)
SCHULMANAGER_BASE_URL=https://login.schulmanager-online.de
# Optional (nur Doku/Link, für den Abruf nicht zwingend nötig):
SCHULMANAGER_HOMEWORK_URL=https://login.schulmanager-online.de/#/modules/classbook/homework/
SCHULMANAGER_USERNAME=deine.mail@example.de
SCHULMANAGER_PASSWORD=DEIN_PASSWORT

# Überwachungsfenster
# false = rollierendes Fenster (Lookback/Lookahead) statt nur "aktuelle Woche"
ONLY_CURRENT_WEEK=false
HOMEWORK_LOOKBACK_DAYS=10
HOMEWORK_LOOKAHEAD_DAYS=7

# Zeitplan (Cron-Format, Zeitzone über TZ)
# Alle 5 Minuten zwischen 06:00 und 22:55 Uhr (Stunde 22 eingeschlossen)
CRON_SCHEDULE=*/5 6-22 * * *
# true = direkt beim Containerstart einmal ausführen
RUN_ON_START=true

# Aufbewahrung (Rotation der Snapshots/Reports)
RETENTION_DAYS=31

# Mailversand
MAIL_ENABLED=true
# "changes" = nur bei Änderungen mailen
MAIL_MODE=changes
# true = bei Fehlern zusätzlich eine Fehlermail senden
MAIL_ON_ERROR=true

# SMTP (Port 587: SMTP_SECURE=false = STARTTLS)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.de
SMTP_PASS=DEIN_SMTP_PASSWORT
MAIL_FROM=hausaufgabe@example.de
MAIL_TO=empfaenger@example.de

# Bereiche erfassen (false pausiert den jeweiligen Abruf vollständig)
WATCH_HOMEWORK=true
WATCH_ABSENCES=true
WATCH_ENTRIES=true
WATCH_HISTORY=true
WATCH_EXAMS=true
WATCH_TIMETABLE=true

# Änderungsmails getrennt steuern; Erfassung läuft bei MAIL_*=false weiter
MAIL_HOMEWORK=true
MAIL_ABSENCES=true
MAIL_ENTRIES=true
# Stundengenaue Historie wird gespeichert; standardmäßig keine zusätzliche Mail
MAIL_HISTORY=false
MAIL_EXAMS=true
MAIL_TIMETABLE=true

# Wiederholte gleiche Abruffehler frühestens nach 6 Stunden erneut melden
ERROR_MAIL_COOLDOWN_MINUTES=360

# Optionale Experteneinstellungen (leer = automatische Schülerauswahl)
SCHULMANAGER_STUDENT_ID=
HEADLESS=true
PW_TIMEOUT_MS=45000
# SCHULMANAGER_USER_AGENT kann bei Bedarf überschrieben werden.
# Alternativ zu direkten Werten sind Dateien weiterhin unterstützt:
# SCHULMANAGER_USERNAME_FILE=/app/secrets/username
# SCHULMANAGER_PASSWORD_FILE=/app/secrets/password
# SMTP_PASS_FILE=/app/secrets/smtp_password
# Dafür secrets/ ausdrücklich schreibgeschützt in Compose einbinden.
